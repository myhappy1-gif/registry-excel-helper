# 설정 예시 파일입니다. 이름만 적고, 비밀 값은 절대 넣지 않습니다.
# 실제 값은 `.env` 파일(깃에 올라가지 않음)에 넣으세요.

# 글자 읽기 방식: sample(미리 읽어 둔 결과, 기본값·배포판) 또는 local(이 컴퓨터에서 Tesseract.js로 읽기)
OCR_MODE=sample

# AI(LLM)로 읽기를 쓰려면 아래 키를 `.env`에 넣으세요(값은 여기에 적지 마세요). 키가 없으면 화면에 이 선택지가 나오지 않습니다.
# 주의: 이 방법은 등기 파일을 외부 서버(OpenAI)로 보냅니다. 지금은 가짜 샘플(fake-) 파일만 보냅니다.
# OPENAI_API_KEY=
# 쓸 AI 모델 이름(선택, 기본 gpt-4o)
# LLM_MODEL=gpt-4o

# 작업 상태·임시 파일 폴더 (이 컴퓨터에서만 사용, 배포판에서는 쓰지 않음)
WORK_DIR=.work
